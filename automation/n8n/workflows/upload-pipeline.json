    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Assemble the payload for PUT /internal/timeline-entries/{id}/parsed (contracts/events.md 2.4)\nconst v = $('Validate event').item.json;\nconst c = $('Compress + store').item.json;\nconst a = $('Anchor hash on Solana').item.json;   // has .error instead of .solana_tx if anchoring failed\nconst f = $json;                                   // output of 'Flag abnormal values'\nreturn { json: {\n  payload: {\n    document_type: f.document_type,\n    document_date: f.document_date,\n    file: c.file,\n    doc_hash: c.doc_hash,\n    solana_tx: a.solana_tx || null,                // null = \"verification pending\"\n    parsed: f.parsed,\n    summary_for_timeline: f.summary_for_timeline,\n    source_label: v.source === 'provider' ? 'Provider-verified' : 'Patient-uploaded, unverified',\n  },\n  flagged: f.flagged,\n  abnormal_count: f.abnormal_count,\n} };"
      },
