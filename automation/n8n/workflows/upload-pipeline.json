    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Any failed stage lands here. Work out which stage and a short error code.\nconst prev = (typeof $prevNode !== 'undefined' && $prevNode.name) ? $prevNode.name : 'unknown';\nconst stage = {\n  'Status: compressing': 'compressing', 'Compress + store': 'compressing',\n  'Status: extracting': 'extracting', 'Gemini extract': 'extracting',\n  'Flag abnormal values': 'flagging', 'Save parsed record': 'saving',\n}[prev] || 'unknown';\nconst err = $json.error || $json;\nconst text = typeof err === 'string' ? err : JSON.stringify(err);\nconst m = /\"code\"\\s*:\\s*\"([A-Z_]+)\"/.exec(text) || /\\\\\"code\\\\\":\\\\\"([A-Z_]+)\\\\\"/.exec(text);\nconst v = $('Validate event').item.json;\nreturn { json: {\n  entry_id: v.entry_id, patient_id: v.patient_id, stage, failed_node: prev,\n  code: m ? m[1] : (stage === 'extracting' ? 'GEMINI_ERROR' : 'PROCESSING_ERROR'),\n  message: String((err && err.message) || text).slice(0, 500),\n} };"
      },
