      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Check the event BEFORE accepting it. Document contents are never read here.\nconst h = $json.headers || {};\nconst body = $json.body || {};\nconst d = body.data || {};\nconst f = d.file || {};\nconst errors = [];\nconst expected = $env.N8N_WEBHOOK_TOKEN;\nif (!expected || h['x-medchain-webhook-token'] !== expected) errors.push('missing or wrong X-MedChain-Webhook-Token header');\nif (body.event_type !== 'document.uploaded') errors.push('event_type must be document.uploaded');\nconst idOk = (s) => typeof s === 'string' && /^[A-Za-z0-9_-]{1,64}$/.test(s);\nif (!idOk(d.entry_id)) errors.push('data.entry_id missing or invalid');\nif (!idOk(d.patient_id)) errors.push('data.patient_id missing or invalid');\nif (!['lab_report', 'prescription', 'bill', 'unknown'].includes(d.document_type)) errors.push('data.document_type invalid');\nif (!['provider', 'patient_uploaded'].includes(d.source)) errors.push('data.source must be provider or patient_uploaded');\nif (typeof f.raw_object_key !== 'string' || !f.raw_object_key.startsWith('raw/' + d.patient_id + '/') || f.raw_object_key.includes('..'))\n  errors.push('data.file.raw_object_key must be raw/<patient_id>/...');\nif (!['image/jpeg', 'image/png', 'image/webp', 'image/heic', 'image/heif', 'application/pdf'].includes(f.mime_type))\n  errors.push('data.file.mime_type not allowed');\nif (!(f.size_bytes > 0 && f.size_bytes <= 20 * 1024 * 1024)) errors.push('data.file.size_bytes must be 1 byte to 20 MB');\nif (d.source === 'provider' && !d.consent_grant_id) errors.push('provider uploads need consent_grant_id');\nconst sex = ((d.patient_context || {}).sex || '').toUpperCase();\nreturn { json: {\n  valid: errors.length === 0, errors,\n  event_id: body.event_id || null,\n  correlation_id: body.correlation_id || body.event_id || null,\n  entry_id: d.entry_id, patient_id: d.patient_id,\n  document_type: d.document_type, source: d.source, channel: d.channel || 'web',\n  raw_object_key: f.raw_object_key, mime_type: f.mime_type,\n  patient_sex: ['M', 'F'].includes(sex) ? sex : null,\n} };"
      },
