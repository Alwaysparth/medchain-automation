# MedChain automation (Member 2)
# Copy to .env (same folder) and fill in. .env is git-ignored. NEVER commit real values.

# ---- Shared secrets: make up long random strings (e.g. python -c "import secrets;print(secrets.token_urlsafe(32))")
INTERNAL_SERVICE_TOKEN=Tjsui-AdMqdCAPOlAw2cCBuu8krrSwaQjg_DzLkW8Cs     # n8n -> API / ai-worker   (Authorization: Bearer ...)
N8N_WEBHOOK_TOKEN=VsCrADCPy-gnXmwgqQtrLnql0L6wGrBF3ppAx5uM8Ms          # API -> n8n               (X-MedChain-Webhook-Token)

# ---- Gemini (Step 2)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash      # list yours: python automation/ai/extract.py --list-models
GEMINI_MAX_ATTEMPTS=3

# ---- File storage (Step 5): MongoDB Atlas (GridFS)
# mongodb = MongoDB Atlas, same as on Render.  local = Docker volume on this laptop (works offline, no Atlas).
STORAGE_BACKEND=local
MONGODB_URI=              # mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=        # separate database from Member 1's timeline data
MOCK_DB_BACKEND=file               # mongodb = keep the mock API's state in Atlas too

# ---- Service URLs seen by n8n. Defaults point at the local containers; change when the real ones exist.
MEDCHAIN_API_URL=https://medchain-backend-4hem.onrender.com             # Member 1's API
SOLANA_CLIENT_URL=https://medchain-blockchain.onrender.com      # Member 3's Solana client
AI_WORKER_URL=http://ai-worker:8000
N8N_PUBLIC_URL=http://localhost:5678/
N8N_VERSION=latest

# ---- Compression (Step 4) — defaults are fine
COMPRESS_MAX_FILE_MB=20
COMPRESS_MAX_SIDE=3000
COMPRESS_MIN_PSNR=40

# ---- Mock only: fraction of Solana anchor calls that fail (0 to 1), to test the "verification pending" path
MOCK_SOLANA_FAIL_RATE=0
