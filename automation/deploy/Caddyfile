# Caddy gets and renews a free Let's Encrypt certificate for N8N_DOMAIN automatically.
{
	email {$ACME_EMAIL}
}

{$N8N_DOMAIN} {
	encode gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		-Server
	}
	reverse_proxy n8n:5678
}
